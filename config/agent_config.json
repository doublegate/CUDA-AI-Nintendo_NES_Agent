{
    "agent": {
        "learning_rate": 0.0001,
        "discount_factor": 0.99,
        "exploration_rate": 0.1,
        "exploration_decay": 0.995,
        "exploration_min": 0.01,
        "frame_skip": 4,
        "frame_stack_size": 4,
        "batch_size": 32,
        "memory_capacity": 100000,
        "target_update_frequency": 10000,
        "model_save_frequency": 1000
    },
    "network": {
        "conv_layers": [
            {
                "filters": 32,
                "kernel_size": 8,
                "stride": 4
            },
            {
                "filters": 64,
                "kernel_size": 4,
                "stride": 2
            },
            {
                "filters": 64,
                "kernel_size": 3,
                "stride": 1
            }
        ],
        "fc_layers": [512, 256],
        "optimizer": "Adam"
    },
    "training": {
        "episodes": 10000,
        "max_steps_per_episode": 50000,
        "checkpoint_frequency": 100,
        "evaluation_frequency": 100,
        "evaluation_episodes": 10
    },
    "emulation": {
        "rom_path": "roms/super_mario_bros.nes",
        "save_state_path": "states/",
        "frame_width": 256,
        "frame_height": 240,
        "display_scale": 2.5
    },
    "cuda": {
        "device_id": 0,
        "memory_fraction": 0.8,
        "use_tensor_cores": true
    },
    "logging": {
        "level": "info",
        "log_to_file": true,
        "log_path": "logs/",
        "tensorboard": true,
        "tensorboard_path": "runs/"
    },
    "reward_shaping": {
        "mario": {
            "move_right": 1.0,
            "x_progress": 1.0,
            "death_penalty": -15.0,
            "time_penalty": -0.1,
            "stage_completion": 100.0
        }
    }
}
